# Copy to .env before `docker compose up`. Values are development constants only.

# --- backend ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/categories
TRANSACTIONS_API_URL=http://mock:8080
AUTH_HS256_SECRET=assignment-dev-secret
PORT=8081

# --- postgres (used by the db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=categories

# --- web (web/.env) ---
VITE_TRANSACTIONS_API_URL=http://localhost:8080
VITE_CATEGORIES_API_URL=http://localhost:8081
# Generate with: node mock/token.mjs owner-a
VITE_ACCESS_TOKEN=
